# Copy to backend/.env for local development. Never commit real values.
# Every variable is validated at startup (src/config/env.ts); the API refuses to start if one is wrong.

NODE_ENV=development

# Port the API listens on (Render injects its own).
PORT=4000

# Atlas connection string with the database name before the "?" (lms_dev locally, lms_prod on Render).
MONGODB_URI=mongodb+srv://change-me:change-me@cluster.example.mongodb.net/lms_dev?retryWrites=true&w=majority

# At least 32 random characters, e.g. `openssl rand -base64 48`. Same value on Render and Vercel.
JWT_SECRET=change-me-to-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Number of proxies in front of the API: 1 locally; measured on Render (see docs/DEPLOYMENT.md).
TRUST_PROXY_HOPS=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
