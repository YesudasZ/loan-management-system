# Copy to backend/.env for local development. Never commit real values.

# Port the API listens on (Render injects its own).
PORT=4000

# The variables below are read from feat/backend-foundation-auth onwards.
# NODE_ENV=development
# MONGODB_URI=mongodb+srv://change-me:change-me@cluster.example.mongodb.net/lms_dev
# JWT_SECRET=change-me-to-at-least-32-random-characters
# CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY_HOPS=1
# LOG_LEVEL=info
