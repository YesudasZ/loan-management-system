# Copy to frontend/.env.local for local development. Never commit real values.
# Both are checked when next.config.ts loads (dev, build and CI); a missing value stops the build.

# Where Next.js proxies /api/* (compiled into the build). No trailing slash.
BACKEND_URL=http://localhost:4000

# Same value as the backend's JWT_SECRET; proxy.ts uses it to read the role from the session cookie.
JWT_SECRET=change-me-to-at-least-32-random-characters
